Items: {
	EaterStaff: {
		DisplayName: Ebonfin Staff
		Tooltip:
			'''
			Summons a curious corrupt fish to fight for you
			Uses 1 minion slot
			'''
	}

	RottenSlicer: {
		DisplayName: Rotten Slicer
		Tooltip:
			'''
			Releases a slow moving wave of energy upon swinging
			Inflicts Cursed Inferno and Withered Armor
			'''
	}

	MiasmaShatter: {
		DisplayName: Miasma Shatter
		Tooltip:
			'''
			Releases miasma clouds
			Striking enemies summons corrupted crystals
			Crystals seek out nearby enemies
			Ignores 20 defense
			'''
	}

	RottenParasite: {
		DisplayName: Rotten Parasite
		Tooltip:
			'''
			Grants the Dangersense effect
			Increases life regeneration by 3
			Has a 10% chance when hurt to confuse nearby enemies
			While at full health increases damage by 60% of your damage resistance
			While at full health damage taken from a hit is reduced by 50%

			[c/B349E6:It feeds on your blood, but grants heightened senses in return]
			'''
	}

	ShadowYoyo: {
		DisplayName: Shadow Yoyo
		Tooltip:
			'''
			Periodically launches homing shadow spikes
			A spike wraps its target in a spinning shadow tangle
			'''
	}

	EpitaphsOrbit: {
		DisplayName: Epitaph's Orbit
		Tooltip:
			'''
			Casts a trio of homing cursed orbs that pass through tiles
			Explodes into an acid blast on impact inflicting Cursed Inferno
			'''
	}

	DefiledSlicingAxe: {
		DisplayName: Defiled Slicing Axe
		Tooltip: ""
	}
}

